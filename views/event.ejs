<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= event.title %> | Event Directory
    </title>
    <link rel="stylesheet" href="/styles.css">
</head>

<body>
    <a href="/events">All events</a>
    <article>
        <h2>
            <%= event.title %>
        </h2>
        <div class="event-date">
            <p>
                <%= event.date %>
            </p>
            <p>
                <%= event.startTime %>-<%= event.endTime %>
            </p>
        </div>
        <p>
            <%= event.location %> hosted by <%= event.organizer %>
        </p>
        <p>Price:<% if (event.price===0) { %>
                Free!
                <% } else { %>
                    $<%= event.price %>
                        <%}%>
        </p>
        <p>
            <%= event.category[0].toUpperCase() + event.category.slice(1) %>
        </p>
        <p>
            <%= event.description %>
        </p>
    </article>
</body>

</html>